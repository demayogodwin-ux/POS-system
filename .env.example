# Copy this file to .env and fill in your Supabase values. .env is gitignored.
# Find them in Supabase: Connect (top bar) > Connection String > Type: JDBC > Method: "Session pooler".
# Use the Session pooler (port 5432): the "Direct connection" address only works on IPv6 networks.
# The password is the database password you chose when creating the project
# (Project Settings > Database > Reset database password if you have lost it).
# No serverTimezone: sale times are stored exactly as the PC clock shows them.
DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DB_USER=postgres.<project-ref>
DB_PASSWORD=
# Optional: how many connections this PC keeps open (overrides db.properties).
# DB_POOL_SIZE=5
