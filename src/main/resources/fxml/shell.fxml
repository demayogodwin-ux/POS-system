<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:id="shellRoot" fx:controller="com.pos.ui.ShellController">

    <left>
        <VBox styleClass="nav-rail">
            <Label text="MS" styleClass="logo-badge">
                <VBox.margin>
                    <Insets bottom="16"/>
                </VBox.margin>
            </Label>

            <ToggleButton fx:id="saleNav" text="Sale" styleClass="nav-item"/>
            <ToggleButton fx:id="ordersNav" text="Orders" styleClass="nav-item"/>
            <ToggleButton fx:id="productsNav" text="Products" styleClass="nav-item"/>
            <ToggleButton fx:id="historyNav" text="History" styleClass="nav-item"/>
            <ToggleButton fx:id="settingsNav" text="Settings" styleClass="nav-item"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Button fx:id="logoutButton" text="Log out" styleClass="nav-item" onAction="#handleLogout"/>
        </VBox>
    </left>

    <center>
        <StackPane fx:id="contentArea" styleClass="content-area"/>
    </center>
</BorderPane>
